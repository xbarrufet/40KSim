      "subAbilityHeader": null
    },
    {
      "lore": null,
      "name": "Gift of the Iron Wolf",
      "rules": "In your Movement phase, at the start or end of this unit's move, select up to one friendly <k>Space Wolves Vehicle</k> model within 3\" of this model:<ul><li>That <k>Vehicle</k> model <b>heals</b> D3 wounds.</li><li>That <k>VEHICLE</k> model’s attacks can ignore modifiers to <b>hit rolls</b> and <b>wound rolls</b> until the start of your next Movement phase.</li></ul>You cannot select the same <k>VEHICLE</k> model for this ability more than once per phase.",
      "isAura": false,
