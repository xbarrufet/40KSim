  "wargearRules": [
    {
      "id": 41212,
      "rulesText": "■ The Terminator Sergeant can have their Power Fist replaced with one of the following:\\n▫ 1 Chainfist\\n▫ 1 Power Weapon",
      "displayOrder": 1
    },
    {
      "id": 42141,
      "rulesText": "■ Any number of Terminator models can each have their Power Fist replaced with 1 Chainfist.",
      "displayOrder": 2
    },
    {
      "id": 41446,
      "rulesText": "■ For every 5 models in this unit, 1 Terminator model can have their Storm Bolter replaced with one of the following:\\n▫ 1 Assault Cannon\\n▫ 1 Heavy Flamer\\n▫ 1 Cyclone Missile Launcher and 1 Storm Bolter (that model’s Storm Bolter cannot be replaced).",
      "displayOrder": 3
    }
  ],
