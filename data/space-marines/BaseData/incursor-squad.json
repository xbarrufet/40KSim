    {
      "lore": null,
      "name": "Haywire Mine (Once per battle, per unit)",
      "rules": "In your Shooting phase, you can select one <b>visible</b> enemy unit within 6\" of this unit and roll one D6. On a 2+:\\r<ul><li>That enemy unit suffers D3 <b>mortal wounds</b>.</li>\\r<li><u>Or:</u> If that enemy unit is a <k>Vehicle</k> unit, that enemy unit suffers 2D3 <b>mortal wounds</b>.</li></ul>",
      "isAura": false,
      "isPain": false,
      "isPsychic": false,
      "isBondsman": false,
      "abilityType": "datasheet",
      "restriction": null,
      "displayOrder": 0,
